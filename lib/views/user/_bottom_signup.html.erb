<%# locals: (last_tabindex:) %>
<p>
  <label class="form_label" for="user_signup_telephone_number"><%= _('Telephone number:') %></label>
  <%= text_field 'user_signup', 'telephone_number', { :size => 14, :tabindex => (last_tabindex+10) } %>
</p>
<div class="form_item_note">
  <%= _("Providing your telephone number is not necessary for creating your account nor for sending a Woo request. Providing your telephone number can be done at a later stage if desired. For more information see: {{link}}",
        link: link_to(_("Why provide telephone number"), help_why_provide_telephone_number_path, target: '_blank')) %>
</div>
